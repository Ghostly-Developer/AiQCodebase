# Copy to .env (git-ignored) or set these in your shell.

# Answer generation: set one or both. --llm picks; default is whichever key is present (Google first).
GOOGLE_API_KEY=
GROQ_API_KEY=

# Optional model overrides (provider model names change often; check their model lists)
ASKCODE_GOOGLE_MODEL=gemini-2.5-flash
ASKCODE_GROQ_MODEL=llama-3.3-70b-versatile
ASKCODE_GOOGLE_EMBED_MODEL=gemini-embedding-001

# Only for --store pgvector (see docker-compose.yml)
DATABASE_URL=postgresql://askcode:askcode@localhost:5432/askcode

# Where indexes and cloned repos are stored (default: ./.askcode)
ASKCODE_HOME=
